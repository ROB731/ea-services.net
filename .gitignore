# Données vivantes du site — jamais versionnées : elles changent à chaque
# visite et écraseraient la production en cas de restauration.
data/site.sqlite
data/*.sqlite
storage/sessions/
storage/cache/
storage/logs/
*.log

# Clés d'API et autres secrets — jamais dans le dépôt, jamais côté client.
config/secrets.php

# Photos et vidéos téléversées depuis l'administration — contenu vivant,
# jamais versionné (comme data/site.sqlite). Seul .gitkeep reste suivi pour
# que le dossier existe après un clone.
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/articles/
public/uploads/articles/*
!public/uploads/articles/.gitkeep
